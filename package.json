{
  "name": "what-to-eat",
  "private": true,
  "version": "0.0.0",
  "description": "今天吃什么？帮不知道这一餐吃什么的人快速做决定",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "menu": "node scripts/prepare-menu.js",
    "predev": "npm run menu",
    "dev": "vite",
    "prebuild": "npm run menu",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run menu",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:migrate:local": "wrangler d1 migrations apply what-to-eat-test --local --config backend/cloudflare/wrangler.jsonc",
    "cf:dev": "wrangler dev --config backend/cloudflare/wrangler.jsonc --port 8787",
    "cf:deploy": "wrangler deploy --config backend/cloudflare/wrangler.jsonc",
    "cf:pages:deploy": "cd backend/cloudflare/pages && wrangler pages deploy --commit-dirty=true"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.11.0",
    "@tabler/icons-vue": "^3.50.0",
    "better-auth": "1.7.18",
    "read-excel-file": "^9.3.14",
    "vue": "^3.5.44",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@cloudbase/cli": "3.9.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "4.158.0"
  }
}
