// 备用后台（Cloudflare Workers + D1）的配置。阶段 4-1 连通测试用。
// 本机运行：npm run cf:dev（数据库存在本机 .wrangler 文件夹里，不碰线上）
// 部署前要做的（用户自己的 Cloudflare 账号）：
//   1. npx wrangler login
//   2. npx wrangler d1 create what-to-eat-test --location apac（建在亚太区域），把输出的 database_id 填到下面
//   3. npx wrangler d1 migrations apply what-to-eat-test --remote
//   4. npx wrangler secret put TEST_INVITE（输入测试邀请码，发给测试的朋友）
//   5. npm run cf:deploy
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "what-to-eat-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "what-to-eat-test",
      // wrangler d1 create --location apac 输出的 id（2026-11-10 建在亚太区域，离大陆用户近）
      "database_id": "d7b7815d-9b29-406b-8555-73df3af3685e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 允许调用的网页：正式网站（GitHub Pages）和本机开发地址
    "ALLOWED_ORIGINS": "https://weit0529.github.io,http://localhost:5173",
    // 后台自己的网址（登录库 Better Auth 要用）
    "AUTH_BASE_URL": "https://what-to-eat-test.wt040529.workers.dev"
  },
  "observability": { "enabled": true }
}
